{
  "name": "mongez-restaurant-management",
  "version": "1.0.0",
  "description": "Mongez Restaurant Management desktop application",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64"
  },
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "chart.js": "^4.5.1",
    "jsonwebtoken": "^9.0.3",
    "node-machine-id": "^1.1.12",
    "sqlite3": "^6.0.1"
  },
  "build": {
    "appId": "com.mongez.restaurant",
    "productName": "Mongez Restaurant Management",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "src/**/*",
      "package.json",
      "tools/**/*"
    ],
    "asar": false
  }
}